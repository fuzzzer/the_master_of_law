# Fuzzzy Law — production nginx site
#
#   Cloudflare (proxied, Full strict)  →  nginx :443  →  127.0.0.1:8000 (docker)
#
# Install on the VPS as /etc/nginx/sites-available/fuzzzy-law and symlink into
# sites-enabled. The walkthrough is .user_tasks/ovh_hosting_guide.md. Every
# non-obvious line below says why it is there; the ones marked 🔴 are the ones
# that are wrong in a generic reverse-proxy template and matter for THIS app.

# 🔴 Log the path, not the query string. Under BYOK the caller's Google API
# key travels in the WebSocket query string (?api_key=…) because browsers
# cannot set headers on a WS handshake. The default log format writes
# "$request", which includes the query string — i.e. every user's API key
# into /var/log/nginx/access.log in plain text. This format writes $uri.
log_format fuzzzy_noquery '$http_cf_connecting_ip - [$time_local] '
                          '"$request_method $uri $server_protocol" $status '
                          '$body_bytes_sent $request_time';

server {
    listen 80;
    listen [::]:80;
    server_name api.zrdai.work;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name api.zrdai.work;

    # Cloudflare Origin CA certificate. Only Cloudflare trusts it, which is
    # the point: it authenticates the Cloudflare → origin hop under
    # "Full (strict)". Browsers connecting directly would see an error, and
    # they should never connect directly — see the ufw step in the guide.
    ssl_certificate     /etc/nginx/ssl/cloudflare-origin.pem;
    ssl_certificate_key /etc/nginx/ssl/cloudflare-origin.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    access_log /var/log/nginx/fuzzzy-law.access.log fuzzzy_noquery;
    error_log  /var/log/nginx/fuzzzy-law.error.log warn;

    # No file uploads in this API (no UploadFile anywhere in app/routes/), so
    # this only bounds JSON bodies. 10m matches the existing production doc.
    client_max_body_size 10m;

    # Security headers. HSTS is safe because Cloudflare "Always Use HTTPS"
    # already guarantees the redirect at the edge.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # The API has exactly one public prefix. Everything else on this host is
    # a 404, including /docs, which the app already disables in production.
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        # 🔴 Behind Cloudflare, $remote_addr is a Cloudflare edge address.
        # The real client is in CF-Connecting-IP, which Cloudflare sets and
        # which cannot be spoofed THROUGH Cloudflare. Set X-Forwarded-For to
        # it outright rather than appending with $proxy_add_x_forwarded_for:
        # appending keeps whatever the client sent first, and uvicorn takes
        # the leftmost address. The app hashes this IP into an anonymous
        # identity when a device id is missing (anonymous_identity.py), so a
        # wrong or uniform value here merges strangers' cases.
        proxy_set_header X-Real-IP         $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-For   $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket upgrade for /api/v1/chat/{id}/ws. Harmless on plain HTTP
        # requests: without an Upgrade header nginx forwards normally.
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # A chat turn runs the whole RAG pipeline — retrieval, rerank, model
        # call, citation verification — and can legitimately take minutes.
        # nginx's default 60s read timeout would cut it off mid-answer. The
        # WebSocket keeps itself alive with status frames; this covers the
        # REST /send and /agent routes and the gaps between WS frames.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        # Stream responses as they arrive instead of buffering the whole
        # answer, so WS frames and long REST responses reach the client
        # promptly.
        proxy_buffering off;
    }

    location / {
        return 404;
    }
}

# Maps a request's Upgrade header to the Connection value nginx should send
# upstream: "upgrade" for a WebSocket handshake, "close" otherwise. Belongs in
# the http context, which is where sites-enabled files are included.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}
