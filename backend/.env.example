# ═══════════════════════════════════════════════════════════════
#  FUZZZY LAW — Environment Configuration
#  ⚠️  NEVER commit .env to git. Only .env.example is tracked.
# ═══════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────
APP_NAME=fuzzzy-law
APP_ENV=production
APP_PORT=8000
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=CHANGE-ME-generate-a-random-32-char-string
ADMIN_API_KEY=CHANGE-ME-generate-a-random-32-char-string
APP_CORS_ORIGINS=https://yourdomain.ge

# ── Access model: login and bring-your-own-key ───────────────
# AUTH_ENABLED=false  → no login. Callers are identified only by the
#                       X-Device-Id header their app generates, which is
#                       enough to keep each install's cases separate.
#                       Firebase is never touched, so NO Firebase service
#                       account credential is needed on this server.
# BYOK_REQUIRED=true  → every caller supplies their own Google AI Studio key
#                       and it pays for all model calls made for them. The
#                       operator is never billed for user traffic, and the
#                       server needs no Gemini key of its own.
#
# v1 launch mode is the pair below. To go back to accounts + operator-paid
# AI, set AUTH_ENABLED=true and BYOK_REQUIRED=false — no code change.
AUTH_ENABLED=false
BYOK_REQUIRED=true
# Header carrying the caller's key. The Flutter app already sends X-API-Key,
# so leaving this alone means no client release is needed.
BYOK_KEY_HEADER=X-API-Key

# ── Google Cloud / Vertex AI ─────────────────────────────────
# NOTE: with BYOK_REQUIRED=true none of the credentials in this section are
# used for user traffic — keys arrive per request. Leave GEMINI_API_KEY empty.
# GCP_SA_KEY_PATH is still read by docker-compose, so it must point at some
# readable file even when unused.
GOOGLE_CLOUD_PROJECT=gen-lang-client-0225498420
GOOGLE_CLOUD_LOCATION=us-central1
# Model tiers — both env-settable, both currently gemini-3.7-flash.
#   STRONG = phase-2 generation + tools, case analysis, documents
#   CHEAP  = guardrail, planning, rerank, verification, guard passes
# Legacy GEMINI_MODEL / GEMINI_CHAT_MODEL are accepted as aliases.
GEMINI_STRONG_MODEL=gemini-3.7-flash
GEMINI_CHEAP_MODEL=gemini-3.7-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
#
# Vertex AI API key (from GCP Console → APIs & Services → Credentials):
VERTEX_AI_API_KEY=your-api-key-here
# Path to GCP Service Account Key OR your local ADC file for Vertex AI (required by docker-compose)
# For local dev usually: ~/.config/gcloud/application_default_credentials.json
GCP_SA_KEY_PATH=~/.config/gcloud/application_default_credentials.json

# ── Vector Store ─────────────────────────────────────────────
# Path INSIDE the Docker container (mounted via docker-compose volume)
CHROMA_PERSIST_DIR=/app/law_corpus_data/chroma

# ── Database ─────────────────────────────────────────────────
# PostgreSQL is INTERNAL ONLY — no port exposure to host or internet.
# Only the API container can reach it via Docker's mol_internal network.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=CHANGE-ME-generate-a-random-32-char-string
DATABASE_URL=postgresql+asyncpg://fuzzzy_user:${POSTGRES_PASSWORD}@postgres:5432/fuzzzy_law
DATABASE_POOL_SIZE=10

# ── Redis ────────────────────────────────────────────────────
# Redis is also INTERNAL ONLY — no port exposure.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=CHANGE-ME-generate-a-random-32-char-string
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# ── Firebase ─────────────────────────────────────────────────
# Only used when AUTH_ENABLED=true. Left blank in the no-login launch mode.
FIREBASE_PROJECT_ID=gen-lang-client-0225498420

# ── Credit System ────────────────────────────────────────────
# Ignored when AUTH_ENABLED=false: credits meter the OPERATOR's AI spend, and
# under BYOK there is none to meter.
FREE_TIER_DAILY_CREDITS=5
CREDIT_COST_CHAT=1
CREDIT_COST_ANALYSIS=2
CREDIT_COST_CASE_FILE=3

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_FREE_PER_MINUTE=5
RATE_LIMIT_PRO_PER_MINUTE=30
RATE_LIMIT_ADMIN_PER_MINUTE=120
# Applies when AUTH_ENABLED=false. Abuse protection only — with BYOK the real
# ceiling is the caller's own Google quota, so this can be generous.
RATE_LIMIT_ANON_PER_MINUTE=20

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=WARNING
