# ═══════════════════════════════════════════════════════════════
#  FUZZZY LAW — Environment Configuration
#  ⚠️  NEVER commit .env to git. Only .env.example is tracked.
# ═══════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────
APP_NAME=fuzzzy-law
APP_ENV=production
APP_PORT=8000
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=CHANGE-ME-generate-a-random-32-char-string
ADMIN_API_KEY=CHANGE-ME-generate-a-random-32-char-string
APP_CORS_ORIGINS=https://yourdomain.ge

# ── Google Cloud / Vertex AI ─────────────────────────────────
GOOGLE_CLOUD_PROJECT=gen-lang-client-0225498420
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-3.1-pro
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
#
# Vertex AI API key (from GCP Console → APIs & Services → Credentials):
VERTEX_AI_API_KEY=your-api-key-here
# Path to GCP Service Account Key OR your local ADC file for Vertex AI (required by docker-compose)
# For local dev usually: ~/.config/gcloud/application_default_credentials.json
GCP_SA_KEY_PATH=~/.config/gcloud/application_default_credentials.json

# ── Vector Store ─────────────────────────────────────────────
# Path INSIDE the Docker container (mounted via docker-compose volume)
CHROMA_PERSIST_DIR=/app/law_corpus_data/chroma

# ── Database ─────────────────────────────────────────────────
# PostgreSQL is INTERNAL ONLY — no port exposure to host or internet.
# Only the API container can reach it via Docker's mol_internal network.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=CHANGE-ME-generate-a-random-32-char-string
DATABASE_URL=postgresql+asyncpg://fuzzzy_user:${POSTGRES_PASSWORD}@postgres:5432/fuzzzy_law
DATABASE_POOL_SIZE=10

# ── Redis ────────────────────────────────────────────────────
# Redis is also INTERNAL ONLY — no port exposure.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=CHANGE-ME-generate-a-random-32-char-string
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# ── Firebase ─────────────────────────────────────────────────
FIREBASE_PROJECT_ID=gen-lang-client-0225498420

# ── Credit System ────────────────────────────────────────────
FREE_TIER_DAILY_CREDITS=5
CREDIT_COST_CHAT=1
CREDIT_COST_ANALYSIS=2
CREDIT_COST_CASE_FILE=3

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_FREE_PER_MINUTE=5
RATE_LIMIT_PRO_PER_MINUTE=30
RATE_LIMIT_ADMIN_PER_MINUTE=120

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=WARNING
