# ============================================================
# Georgian Law Corpus Pipeline — Environment Configuration
# ============================================================
# Copy this file to er.env and fill in your values.

# ── Google Cloud / Vertex AI ─────────────────────────────────
# Auth: run 'gcloud auth application-default login' (no API key needed)
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
EMBEDDING_MODEL=text-embedding-005
EMBEDDING_DIMENSIONS=768

# ── Vector Store ─────────────────────────────────────────────
# "chroma" for local dev, "vertex" for production
VECTOR_STORE_BACKEND=chroma
CHROMA_PERSIST_DIR=./data/chroma
VERTEX_VECTOR_SEARCH_INDEX_ID=
VERTEX_VECTOR_SEARCH_ENDPOINT_ID=

# ── PostgreSQL ───────────────────────────────────────────────
# These are used by docker-compose.yml AND by the pipeline directly.
POSTGRES_DB=law_corpus
POSTGRES_USER=corpus
POSTGRES_PASSWORD=corpus_dev_pw
POSTGRES_PORT=5432
POSTGRES_BIND=127.0.0.1          # 127.0.0.1 = localhost only; 0.0.0.0 = allow remote
# Composed URL for the pipeline (when running outside Docker):
DATABASE_URL=postgresql+asyncpg://corpus:corpus_dev_pw@localhost:5432/law_corpus

# ── Scraping ─────────────────────────────────────────────────
SCRAPE_DELAY_SECONDS=2
SCRAPE_MAX_CONCURRENT=3
SCRAPE_USER_AGENT=LawCorpusBot/1.0 (research; contact@example.com)

# ── Pipeline ─────────────────────────────────────────────────
LOG_LEVEL=INFO
DATA_DIR=./data
CHECKPOINT_DIR=./data/checkpoints
