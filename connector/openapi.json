          },
          "articles": {
            "items": {
              "$ref": "#/components/schemas/ArticleRef"
            },
            "type": "array",
            "title": "Articles"
          },
          "total_articles": {
            "type": "integer",
            "title": "Total Articles",
            "default": 0
          },
          "offset": {
            "type": "integer",
            "title": "Offset",
            "default": 0
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "source_url",
          "found",
          "code"
        ],
        "title": "CodeStructure"
      },
