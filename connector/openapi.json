{
  "openapi": "3.1.0",
  "info": {
    "title": "Fuzzzy Law — Georgian law sources",
    "description": "Exact texts of Georgian codes with official matsne.gov.ge links and version dates, and real Supreme Court decisions where available. Sources only, not legal advice.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://law-api.fuzzzycore.com"
    }
  ],
  "paths": {
    "/api/v1/connector/codes": {
      "get": {
        "tags": [
          "law connector"
        ],
        "summary": "List available Georgian codes",
        "description": "Codes with article counts, official links and version dates.",
        "operationId": "listCodes",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CodeList"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/connector/search": {
      "get": {
        "tags": [
          "law connector"
        ],
        "summary": "Search Georgian law articles",
        "description": "Matching articles with exact snippet, link and version date.\n\nfound=false means nothing matched.",
        "operationId": "searchLaw",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "What to look for, best in Georgian legal terms.",
              "title": "Query"
            },
            "description": "What to look for, best in Georgian legal terms."
          },
          {
            "name": "code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional: limit to one code.",
              "title": "Code"
            },
            "description": "Optional: limit to one code."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 25,
              "minimum": 1,
              "description": "How many articles.",
              "default": 8,
              "title": "Limit"
            },
            "description": "How many articles."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchLawResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/connector/articles": {
      "get": {
        "tags": [
          "law connector"
        ],
        "summary": "Get one article's full text",
        "description": "Full exact text, paragraphs, link, version date and neighbouring articles.\n\nUse it to check deadlines.",
        "operationId": "getArticle",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Code id from listCodes (e.g. civil_code) or its Georgian name.",
              "title": "Code"
            },
            "description": "Code id from listCodes (e.g. civil_code) or its Georgian name."
          },
          {
            "name": "article",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Article number, e.g. 369 or 166¹.",
              "title": "Article"
            },
            "description": "Article number, e.g. 369 or 166¹."
          },
          {
            "name": "paragraph",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional paragraph number.",
              "title": "Paragraph"
            },
            "description": "Optional paragraph number."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetArticleResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/connector/structure": {
      "get": {
        "tags": [
          "law connector"
        ],
        "summary": "Show a code's chapters or articles",
        "description": "Chapters of a code, or article numbers and titles.",
        "operationId": "browseCode",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Code id from listCodes (e.g. civil_code) or its Georgian name.",
              "title": "Code"
            },
            "description": "Code id from listCodes (e.g. civil_code) or its Georgian name."
          },
          {
            "name": "chapter",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional chapter to list.",
              "title": "Chapter"
            },
            "description": "Optional chapter to list."
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "description": "Paging offset.",
              "default": 0,
              "title": "Offset"
            },
            "description": "Paging offset."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 300,
              "minimum": 1,
              "description": "Articles per page.",
              "default": 200,
              "title": "Limit"
            },
            "description": "Articles per page."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CodeStructure"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/connector/court-practice": {
      "get": {
        "tags": [
          "law connector"
        ],
        "summary": "Find real court decisions",
        "description": "Supreme Court decisions with case number, date and snippet.\n\nnone_found means do not mention court practice.",
        "operationId": "findCourtPractice",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "Legal issue in Georgian.",
              "title": "Query"
            },
            "description": "Legal issue in Georgian."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 10,
              "minimum": 1,
              "description": "How many decisions.",
              "default": 5,
              "title": "Limit"
            },
            "description": "How many decisions."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CourtPracticeResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/connector/verify-citation": {
      "post": {
        "tags": [
          "law connector"
        ],
        "summary": "Check a law citation",
        "description": "Whether the article exists and what it says, with a word-and-number overlap check.",
        "operationId": "verifyCitation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyCitationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyCitationResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ArticleHit": {
        "properties": {
          "source_url": {
            "type": "string",
            "title": "Source Url",
            "description": "Official matsne.gov.ge link for this text."
          },
          "version_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version Date",
            "description": "Date of the consolidated version this text comes from."
          },
          "in_force_since": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "In Force Since",
            "description": "Date this article's current wording took effect, if known."
          },
          "version_note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version Note",
            "description": "Present when a version date is unknown or text may be incomplete."
          },
          "notice": {
            "type": "string",
            "title": "Notice",
            "default": "ეს არის კანონის ტექსტი და წყარო, არა იურიდიული კონსულტაცია. ოფიციალური ტექსტი: matsne.gov.ge. This is law text and its source, not legal advice. The official text is on matsne.gov.ge; for important decisions consult a lawyer."
          },
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Stable id, usable with fetch: article:<code>:<number>."
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "code_name": {
            "type": "string",
            "title": "Code Name"
          },
          "article_number": {
            "type": "string",
            "title": "Article Number",
            "description": "As printed in the law, e.g. 'მუხლი 369'."
          },
          "article_title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Article Title"
          },
          "paragraph": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Paragraph",
            "description": "Paragraph the snippet is from."
          },
          "snippet": {
            "type": "string",
            "title": "Snippet",
            "description": "Exact text copied from the stored article (may be an excerpt)."
          },
          "is_repealed": {
            "type": "boolean",
            "title": "Is Repealed",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "source_url",
          "id",
          "code",
          "code_name",
          "article_number",
          "snippet"
        ],
        "title": "ArticleHit"
      },
      "ArticleRef": {
        "properties": {
          "article_number": {
            "type": "string",
            "title": "Article Number"
          },
          "article_title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Article Title"
          }
        },
        "type": "object",
        "required": [
          "article_number"
        ],
        "title": "ArticleRef"
      },
      "ArticleText": {
        "properties": {
          "source_url": {
            "type": "string",
            "title": "Source Url",
            "description": "Official matsne.gov.ge link for this text."
          },
          "version_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version Date",
            "description": "Date of the consolidated version this text comes from."
          },
          "in_force_since": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "In Force Since",
            "description": "Date this article's current wording took effect, if known."
          },
          "version_note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version Note",
            "description": "Present when a version date is unknown or text may be incomplete."
          },
          "notice": {
            "type": "string",
            "title": "Notice",
            "default": "ეს არის კანონის ტექსტი და წყარო, არა იურიდიული კონსულტაცია. ოფიციალური ტექსტი: matsne.gov.ge. This is law text and its source, not legal advice. The official text is on matsne.gov.ge; for important decisions consult a lawyer."
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "code_name": {
            "type": "string",
            "title": "Code Name"
          },
          "article_number": {
            "type": "string",
            "title": "Article Number"
          },
          "article_title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Article Title"
          },
          "chapter": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Chapter"
          },
          "text": {
            "type": "string",
            "title": "Text",
            "description": "Full stored text of the article, unaltered."
          },
          "paragraphs": {
            "items": {
              "$ref": "#/components/schemas/Paragraph"
            },
            "type": "array",
            "title": "Paragraphs"
          },
          "requested_paragraph": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Paragraph"
              },
              {
                "type": "null"
              }
            ]
          },
          "previous_article": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ArticleRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "next_article": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ArticleRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "is_repealed": {
            "type": "boolean",
            "title": "Is Repealed",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "source_url",
          "id",
          "code",
          "code_name",
          "article_number",
          "text",
          "paragraphs"
        ],
        "title": "ArticleText"
      },
      "ChapterSummary": {
        "properties": {
          "chapter": {
            "type": "string",
            "title": "Chapter"
          },
          "article_count": {
            "type": "integer",
            "title": "Article Count"
          },
          "first_article": {
            "type": "string",
            "title": "First Article"
          },
          "last_article": {
            "type": "string",
            "title": "Last Article"
          }
        },
        "type": "object",
        "required": [
          "chapter",
          "article_count",
          "first_article",
          "last_article"
        ],
        "title": "ChapterSummary"
      },
      "CodeList": {
        "properties": {
          "codes": {
            "items": {
              "$ref": "#/components/schemas/CodeSummary"
            },
            "type": "array",
            "title": "Codes"
          },
          "notice": {
            "type": "string",
            "title": "Notice",
            "default": "ეს არის კანონის ტექსტი და წყარო, არა იურიდიული კონსულტაცია. ოფიციალური ტექსტი: matsne.gov.ge. This is law text and its source, not legal advice. The official text is on matsne.gov.ge; for important decisions consult a lawyer."
          }
        },
        "type": "object",
        "required": [
          "codes"
        ],
        "title": "CodeList"
      },
